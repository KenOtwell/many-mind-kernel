# Per-machine host settings. Copy to `.env` (gitignored) and adjust.
#
# Read by launch-progeny.sh and launch-falcon.ps1, which export these into the
# environment before starting the services; shared/config.py and mindcore.config
# then pick them up. Python itself does not load .env, so when starting a service
# by hand, export the variables first.
#
# Values are router DNS names (each machine has a DHCP-reserved address on the
# router). Use IPs here only as a local override, never in committed files.

# Where Qdrant runs (the Gaming PC / Falcon). Used by Progeny and Falcon.
QDRANT_HOST=Falcon.kenos.one
# QDRANT_REST_PORT=6333
# QDRANT_GRPC_PORT=6334

# Where Progeny runs (the Beelink). Used by Falcon to reach Progeny's WebSocket.
PROGENY_HOST=Progeny.kenos.one
# PROGENY_PORT=8001
